# Copia este archivo como ".env" y pon tus llaves. NUNCA subas el .env a GitHub.

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Gemini (Google) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Grok (xAI) ---
XAI_API_KEY=
GROK_MODEL=grok-4

# Cerebro con el que arranca Axtra: auto, claude, gemini o grok
AXTRA_CEREBRO=auto
# Orden de preferencia en modo auto (si uno falla, pasa al siguiente)
AXTRA_ORDEN=gemini,grok,claude
