# Copia este archivo como .env en el servidor. NUNCA lo subas a GitHub.
AXTRA_USUARIO=Felipe

# --- Cerebros gratis ---
GROQ_API_KEY=
GROQ_MODELO_BASICO=openai/gpt-oss-20b
GROQ_MODELO_INTERMEDIO=openai/gpt-oss-120b
CEREBRAS_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
TAVILY_API_KEY=

# --- Cerebros de pago ---
ANTHROPIC_API_KEY=
CLAUDE_MODELO_BARATO=claude-haiku-4-5
CLAUDE_MODELO=claude-sonnet-5-5
CLAUDE_MODELO_FUERTE=claude-opus-5-5
# Grok: déjalo vacío hasta que quieras activarlo. Pon el modelo y precio que muestre la consola de xAI.
XAI_API_KEY=
GROK_MODELO=grok-4-latest
GROK_PRECIO_ENTRADA=3
GROK_PRECIO_SALIDA=15

# Topes de gasto mensual (dólares). Al llegar, ese cerebro se pausa hasta el mes siguiente.
TOPE_CLAUDE_USD=10
TOPE_GROK_USD=10
# 1 = si todos los gratis fallan, responde Claude Haiku (barato) para no dejarte sin respuesta
PAGO_DE_RESPALDO=1

# --- Acceso: solo tu cuenta de Google (Cloudflare Access) ---
CF_ACCESS_EQUIPO=
CF_ACCESS_AUD=
AXTRA_CORREO=felipemerchanhenao19@gmail.com
# Client ID del token de servicio que usa el Axtra del PC para subir tus datos
CF_ACCESS_SERVICIO_ID=

# --- Túnel de Cloudflare (conecta el servidor con tu dominio sin abrir puertos) ---
TUNNEL_TOKEN=

AXTRA_ZONA=America/Bogota
