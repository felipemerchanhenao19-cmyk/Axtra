# Claves de Apex Play (solo las usa el contenedor "apex"). Copia este archivo como apex.env en el servidor.
# NUNCA lo subas a GitHub ni lo mandes por chat.
OPENAI_API_KEY=
# Modelo por defecto (cada restaurante puede cambiarlo en su archivo restaurantes/<id>.json)
APEX_MODELO=gpt-realtime-2.1-mini
# PIN del panel del mesero de cada restaurante: APEX_PIN_<ID EN MAYÚSCULAS>
APEX_PIN_DEMO=
