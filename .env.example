# Copia este archivo como .env y pon tu clave
ANTHROPIC_API_KEY=sk-ant-PEGA-AQUI-TU-CLAVE

# Cerebro: hibrido (recomendado) | local (nunca gasta saldo) | claude (todo con Claude)
JARVIS_CEREBRO=hibrido
# Gemini (Google): clave GRATIS en aistudio.google.com -> "Get API key". Vacío = no se usa
GEMINI_API_KEY=
JARVIS_MODELO_GEMINI=gemini-flash-latest
# Preguntas e ideas sobre Apex y tus negocios: gemini (gratis) o claude (gasta saldo)
JARVIS_CEREBRO_NEGOCIO=gemini
# Más cerebros gratis (opcionales). Si uno se queda sin cuota, Axtra pasa al siguiente
GROQ_API_KEY=
OPENROUTER_API_KEY=
JARVIS_CEREBROS_GRATIS=gemini,groq,openrouter
# Búsqueda gratis en internet: Tavily (1000/mes, clave en tavily.com). Sin clave usa DuckDuckGo
TAVILY_API_KEY=
# Charla: gemini (más listo y rápido) o local (sin internet, todo en tu PC)
JARVIS_CEREBRO_CHARLA=gemini
# Modelo local de Ollama: qwen2.5:3b (equilibrado) o qwen2.5:1.5b (más rápido)
JARVIS_MODELO_LOCAL=qwen2.5:3b
# Clases de idiomas: gemini (gratis, recomendado) | local (gratis, sin internet) | claude (gasta saldo)
JARVIS_CEREBRO_IDIOMAS=gemini
# Con batería (sin cargador) apaga la cámara de fondo para ahorrar energía: 1 sí, 0 no
JARVIS_AHORRO_BATERIA=1
# Cuánto tiempo queda cargado el cerebro local sin usarse (ocupa unos 2 GB de RAM mientras tanto).
# 10m ahorra RAM; 4h responde más rápido si lo usas seguido; -1 = siempre cargado
JARVIS_MANTENER_CEREBRO=10m

# Opcionales
JARVIS_USER_NAME=Felipe
JARVIS_CITY=Tuluá
JARVIS_LAT=4.0847
JARVIS_LON=-76.1954
JARVIS_VOZ_ESTILO=mayordomo
JARVIS_WHISPER_MODEL=small
JARVIS_VOICE_THRESHOLD=0.50
JARVIS_WAKE_MODE=es
JARVIS_WAKE_THRESHOLD=0.5
JARVIS_REQUIRE_VOICE_MATCH=1

# Voz clonada (opcional): pon edge para volver a la voz gratis
JARVIS_TTS_PROVIDER=edge
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Aprendizaje autónomo
JARVIS_AUTONOMIA=1
# Cerebro del modo autónomo: gemini (gratis, busca en Google) o claude (gasta saldo)
JARVIS_CEREBRO_AUTONOMO=gemini
JARVIS_ESTUDIOS_POR_DIA=3
JARVIS_HORAS_ENTRE_ESTUDIOS=4

# Rutinas diarias (HH:MM, 24 h). Deja vacío para desactivar
JARVIS_BRIEFING_HORA=06:30
JARVIS_INFORME_MERCADO_HORA=16:15
# Tu correo (la SEC de EE. UU. lo pide para dar datos fundamentales)
JARVIS_CONTACTO_SEC=

# Cámara (0 = la del portátil). Saludo al verte llegar: 1 sí, 0 no
JARVIS_CAMARA=0
JARVIS_CAMARA_SALUDO=1

# Modo compañero (Jarvis te habla mientras usas el PC)
JARVIS_CONVERSADOR=1
JARVIS_CONVERSADOR_MINUTOS=45
JARVIS_HORAS_ACTIVAS=08:00-22:30

# --- Axtra en el navegador (python axtra.py web) ---
# Modelo de Gemini para crear imágenes (si no existe, Axtra busca uno disponible)
JARVIS_MODELO_IMAGEN=gemini-2.5-flash-image
# 1 = abrir la página también desde el celular en tu Wi-Fi (exige la clave de abajo)
JARVIS_WEB_RED=0
JARVIS_WEB_CLAVE=
